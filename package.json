{
  "name": "ghidorah-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mettle agent harness monorepo: Ghidorah backend, shared contracts, model gateway, and the frontend workspace. Development fixture only.",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun apps/ghidorah/scripts/mastra-recovery-patch.mjs",
    "patch:mastra": "bun apps/ghidorah/scripts/mastra-recovery-patch.mjs",
    "patch:check": "bun apps/ghidorah/scripts/mastra-recovery-patch.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:check": "bun packages/contracts/scripts/manifest.ts --check",
    "contracts:build": "bun packages/contracts/scripts/manifest.ts --emit",
    "build": "bun run typecheck && bun run contracts:build",
    "test": "bun test apps/ghidorah/test/unit",
    "test:contracts": "bun test apps/ghidorah/test/unit/shared-contracts.test.ts apps/ghidorah/test/unit/model-gateway.test.ts",
    "test:recovery": "bun test apps/ghidorah/test/recovery",
    "test:comparison": "bun test apps/ghidorah/test/comparison",
    "pretest:integration": "bun run patch:check",
    "test:integration": "bun test --timeout 90000 --max-concurrency 1 apps/ghidorah/test/integration",
    "test:all": "bun run test && bun run test:recovery && bun run test:integration && bun run eval",
    "verify": "bun run format:check && bun run typecheck && bun run contracts:check && bun run test:all && bun run test:comparison && bun run repro:native",
    "eval": "bun apps/ghidorah/evals/run.ts",
    "eval:unit": "bun apps/ghidorah/evals/run.ts --unit",
    "eval:list": "bun apps/ghidorah/evals/run.ts --list",
    "precli": "bun run patch:check",
    "cli": "bun apps/ghidorah/src/cli.ts",
    "db:check": "bun apps/ghidorah/scripts/check-database.ts",
    "db:init": "bun apps/ghidorah/src/cli.ts init",
    "repro:native": "bun apps/ghidorah/scripts/native-recovery.ts",
    "acceptance:openrouter": "bun apps/ghidorah/scripts/openrouter-acceptance.ts",
    "frontend:check": "bun apps/frontend/src/check.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  }
}
